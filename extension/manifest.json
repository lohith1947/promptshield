{
  "manifest_version": 3,
  "name": "promptshield - AI prompt privacy guard",
  "version": "0.5.0",
  "description": "Blocks sensitive data from being sent to AI chat sites. Every prompt is scanned by your local promptshield gateway before it leaves the browser. Offers block, mask & send, or send-anyway on detection.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "promptshield"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://grok.com/*",
        "*://x.com/i/grok/*",
        "*://copilot.microsoft.com/*",
        "*://chat.deepseek.com/*",
        "*://www.perplexity.ai/*",
        "*://you.com/*",
        "*://poe.com/*",
        "*://chat.mistral.ai/*",
        "*://meta.ai/*",
        "*://huggingface.co/chat/*",
        "*://chat.duckduckgo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}