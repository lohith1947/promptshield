{
  "manifest_version": 3,
  "name": "promptshield",
  "version": "0.3.0",
  "description": "Blocks sensitive data from being sent to AI chat sites. Every prompt is scanned by your local promptshield gateway before it leaves the browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "promptshield"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://copilot.microsoft.com/*",
        "*://chat.deepseek.com/*",
        "*://www.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}